PROJECT_ID=
PROJECT_SECRET=

# Gemini runs on the backend. Get a key from https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_TIMEOUT_MS=30000
# Per-request timeout in milliseconds (1000–300000).
GEMINI_TIMEOUT_MS=120000

# Optional signed-in account API; guest landing-page intake needs no auth provider.
# The account endpoints refuse operations until all three are configured.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Exact website origins, comma-separated. No wildcard.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
HOST=127.0.0.1
PORT=8080
DATABASE_PATH=data/moretime.sqlite
